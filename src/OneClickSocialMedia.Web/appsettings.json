{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u11}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "logs/log-.txt",
          "RollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u11}] {Message:lj}{NewLine}"
        }
      }
    ]
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "EmailConfiguration": {
    "From": "noreply.oneclicksocialmedia@gmail.com",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "Username": "noreply.oneclicksocialmedia@gmail.com"
  },
  "Authentication": {
    "Google": {
      "ClientId": "506046797672-4hh48q93bcn7pjri1d07vbcc431nm2jb.apps.googleusercontent.com"
    },
    "Facebook": {
      "AppId": "931988059205326"
    },
    "Twitter": {
      "ConsumerKey": "YOUR_KEY"
    }
  }
}
