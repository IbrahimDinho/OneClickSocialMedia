@model SocialMediaViewModel
@{
    ViewData["Title"] = "Home Page";
}

@section Scripts {
    <script src="~/js/home-index.js" asp-append-version="true"></script>
}

<div class="text-center">
    <h1 class="display-4 mb-5 section-title">Post on social media</h1>
</div>

<div class="container-fluid mb-5">

    <div class="container-fluid">
        <form asp-controller="Home" asp-action="PostToSocialMedia" method="post">
            @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-4">
                <div class="card mb-5 p-1">
                    <div class="card-header">
                        <img src="~/images/x-social-media.png" class="card-img-top" alt="x icon" style="width: 40px; height: 40px; object-fit: contain;" />
                    </div>
                    <div class="card-body ">
                        <div class="input-group">
                            <div class="">
                                <label class="form-check-label" for="flexCheckDefault">
                                    Twitter
                                </label>
                                <input class="form-check-input ms-2" type="checkbox" value="" id="flexCheckDefault">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-5 p-1">
                    <div class="card-header">
                        <img src="~/images/facebook-square-icon.png" class="card-img-top" alt="x icon" style="width: 40px; height: 40px; object-fit: contain;" />
                    </div>
                    <div class="card-body">
                        <div class="input-group">
                            <div class="">
                                <label class="form-check-label" for="flexCheckDefault">
                                    Facebook
                                </label>
                                <input class="form-check-input ms-2" type="checkbox" value="" id="flexCheckDefault">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-5 p-1">
                    <div class="card-header">
                        <img src="~/images/ig-instagram-icon.png" class="card-img-top" alt="x icon" style="width: 40px; height: 40px; object-fit: contain;" />
                    </div>
                    <div class="card-body ">
                        <div class="input-group">
                            <div class="">
                                <label class="form-check-label" for="flexCheckDefault">
                                    Instagram
                                </label>
                                <input class="form-check-input ms-2" type="checkbox" value="" id="flexCheckDefault">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                <div class="col-auto d-flex">
                    <div class="vr"></div>
                </div>
            <div class="col">
                <div class="mb-3">
                    <div class="border rounded d-flex align-items-center justify-content-center mb-2"
                         style="height: 150px; background-color: #f8f9fa;">
                        <img id="imagePreview" class="img-fluid d-none" alt="Image preview" />
                        <span id="imagePlaceholder" class="text-muted">Image preview</span>
                    </div>
                <div class="input-group mb-3">
                    <input type="file" class="form-control" id="inputGroupFile02">
                    <label class="input-group-text" for="inputGroupFile02">Upload</label>
                </div>
                    <input type="url"
                           class="form-control mb-5"
                           id="imageUrlInput"
                           placeholder="OR input image URL (https://...)">
                </div>
                <div class="mb-3">
                    <textarea placeholder="Write a comment" class="form-control" id="exampleFormControlTextarea1" rows="9"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Post</button>

            </div>
        </div>
        
    </form>


    </div>
</div>


   


