@{
    ViewData["Title"] = "Settings";
}
<div class="container">
<h1 class="mb-5 text-center">@ViewData["Title"]</h1>

<div class="container-fluid mb-5">

<div class="card">
    <div class="card-header">
        <h5>Twitter</h5>
    </div>
    <div class="card-body">
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text" id="basic-addon1">Twitter API Token</span>
            </div>
            <input type="text" class="form-control" aria-label="Twitter" aria-describedby="basic-addon1">
        </div>
    </div>
</div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Facebook</h5>
        </div>
        <div class="card-body">
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token2</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
        </div>
    </div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Instagram</h5>
        </div>
        <div class="card-body">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Instagram API Token</span>
                </div>
                <input type="text" class="form-control" aria-label="Instagram" aria-describedby="basic-addon1">
            </div>
        </div>
    </div>

</div>

</div>


