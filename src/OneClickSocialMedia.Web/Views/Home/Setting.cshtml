@model SocialMediaSettingsViewModel;
@{
    ViewData["Title"] = "Settings";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
}

@section Scripts {
    <script src="~/js/setting-page.js" asp-append-version="true"></script>
}


<div class="container">
<h1 class="mb-5 text-center">@ViewData["Title"]</h1>

<form asp-controller="Home" asp-action="PostSettings" method="POST">

<div class="container-fluid mb-5">

<div class="card">
    <div class="card-header">
        <h5>Twitter / X</h5>
                    <div class="form-check mb-3">
                        <input class="form-check-input credential-toggle"
                               type="checkbox"
                               asp-for="UpdateTwitterCredentials"
                               id="updateTwitterCredentials"
                               data-target="twitter-credential" />
                        <label class="form-check-label" for="updateTwitterCredentials">
                            Update Twitter / X credentials
                        </label>
                    </div>
    </div>
    <div class="card-body">
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterApiKey" id="twitterApiKeyLabel">
                            API Key
                        </label>
                    </div>
                        <input asp-for="TwitterApiKey" class="form-control twitter-credential" aria-describedby="twitterApiKeyLabel" disabled/>
                 </div>

                    <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterApiSecret" id="twitterApiSecretLabel">
                            API Secret
                        </label>
                    </div>
                        <input asp-for="TwitterApiSecret" class="form-control twitter-credential" aria-describedby="twitterApiSecretLabel" autocomplete="new-password" placeholder="@(Model.HasTwitterApiSecret ? "********" : "")" disabled />
                        <div class="input-group-append" id="TwitterAPISecretToggle">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="togglePassword('TwitterApiSecret', this)">
                            <span class="toggle-text">Show</span>
                            <i class="fa fa-eye ml-1"></i>
                        </button>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterAccessToken" id="twitterAccessTokenLabel">
                            Access Token
                        </label>
                    </div>
                        <input asp-for="TwitterAccessToken" class="form-control twitter-credential" aria-describedby="twitterAccessTokenLabel" disabled />
                </div>

                    <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterAccessTokenSecret" id="twitterAccessTokenSecretLabel">
                            Token Secret
                        </label>
                    </div>
                        <input asp-for="TwitterAccessTokenSecret" class="form-control twitter-credential" aria-describedby="twitterAccessTokenSecretLabel" autocomplete="new-password" placeholder="@(Model.HasTwitterAccessTokenSecret ? "********" : "")" disabled />
                        <div class="input-group-append" id="TwitterAccessTokenSecretToggle">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="togglePassword('TwitterAccessTokenSecret', this)">
                            <span class="toggle-text">Show</span>
                            <i class="fa fa-eye ml-1"></i>
                        </button>
                    </div>
                </div>
                    @if (Model.HasTwitterApiSecret)
                    {
                        <small class="form-text text-muted">
                            A twitter API secret is already saved, for security ******* is shown as a placeholder. Enter a new one to replace it.
                        </small>
                        <br />
                    }
                    @if (Model.HasTwitterAccessTokenSecret)
                    {
                        <small class="form-text text-muted">
                            A twitter access token secret is already saved, for security ******* is shown as a placeholder. Enter a new one to replace it.
                        </small>
                    }

    </div>
</div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Facebook</h5>
        </div>
        <div class="card-body">
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token2</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
        </div>
    </div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Instagram</h5>
                    <div class="form-check mb-3">
                    <input class="form-check-input credential-toggle"
                               type="checkbox"
                               asp-for="UpdateInstagramCredentials"
                               id="updateInstagramCredentials" 
                               data-target="instagram-credential" />
                        <label class="form-check-label" for="updateInstagramCredentials">
                            Update Instagram
                        </label>
                    </div>
        </div>
        <div class="card-body">
            <div class="input-group mb-3">
                <div class="input-group-prepend">
                            <label class="input-group-text" for="InstagramAccessToken" id="InstagramAccessTokenLabel">
                                Instagram Access Token
                            </label>
                </div>
                        <input asp-for="InstagramAccessToken" class="form-control instagram-credential" aria-describedby="InstagramAccessTokenLabel" autocomplete="new-password" placeholder="@(Model.HasInstagramAccessToken ? "********" : "")" disabled />
                        <div class="input-group-append" id="InstagramSecretToggle">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="togglePassword('InstagramAccessToken', this)">
                                <span class="toggle-text">Show</span>
                                <i class="fa fa-eye ml-1"></i>
                            </button>
                 </div>
            </div>
                    @if (Model.HasInstagramAccessToken)
                    {
                        <small class="form-text text-muted">
                            An instagram Access token is already saved, for security ******* is shown as a placeholder. Enter a new one to replace it.
                        </small>
                        <br />
                    }
        </div>
    </div>

</div>

        <div class="text-end">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert @(TempData["Success"] as bool? == true ? "alert-success" : "alert-danger")">
            @TempData["Message"]
        </div>
    }

    </form>
</div>

