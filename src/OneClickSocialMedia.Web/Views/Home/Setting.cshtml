@model SocialMediaSettingsViewModel;
@{
    ViewData["Title"] = "Settings";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
}

@section Scripts {
    <script src="~/js/setting-page.js" asp-append-version="true"></script>
}


<div class="container">
<h1 class="mb-5 text-center">@ViewData["Title"]</h1>

<div class="container-fluid mb-5">

<div class="card">
    <div class="card-header">
        <h5>Twitter / X</h5>
    </div>
    <div class="card-body">
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterApiKey" id="twitterApiKeyLabel">
                            API Key
                        </label>
                    </div>
                    <input asp-for="TwitterApiKey" class="form-control" aria-describedby="twitterApiKeyLabel" />
                 </div>

                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterApiSecret" id="twitterApiSecretLabel">
                            API Secret
                        </label>
                    </div>
                    <input asp-for="TwitterApiSecret" class="form-control" aria-describedby="twitterApiSecretLabel" autocomplete="new-password" />
                    <div class="input-group-append">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="togglePassword('TwitterApiSecret', this)">
                            <span class="toggle-text">Show</span>
                            <i class="fa fa-eye ml-1"></i>
                        </button>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterAccessToken" id="twitterAccessTokenLabel">
                            Access Token
                        </label>
                    </div>
                    <input asp-for="TwitterAccessToken" class="form-control" aria-describedby="twitterAccessTokenLabel" />
                </div>

                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text" for="TwitterAccessTokenSecret" id="twitterAccessTokenSecretLabel">
                            Token Secret
                        </label>
                    </div>
                    <input asp-for="TwitterAccessTokenSecret" class="form-control" aria-describedby="twitterAccessTokenSecretLabel" autocomplete="new-password" />
                    <div class="input-group-append">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="togglePassword('TwitterAccessTokenSecret', this)">
                            <span class="toggle-text">Show</span>
                            <i class="fa fa-eye ml-1"></i>
                        </button>
                    </div>
                </div>

    </div>
</div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Facebook</h5>
        </div>
        <div class="card-body">
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Facebook API Token2</span>
                </div>
                <input type="text" class="form-control" aria-label="Facebook" aria-describedby="basic-addon1">
            </div>
        </div>
    </div>

</div>

<div class="container-fluid mb-5">

    <div class="card">
        <div class="card-header">
            <h5>Instagram</h5>
        </div>
        <div class="card-body">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Instagram API Token</span>
                </div>
                <input type="text" class="form-control" aria-label="Instagram" aria-describedby="basic-addon1">
            </div>
        </div>
    </div>

</div>

</div>

